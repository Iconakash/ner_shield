# NER-SHIELD V2 backend (FastAPI) — environment template
# Copy to .env (gitignored). NEVER commit a populated copy.
# This template carries VARIABLE NAMES ONLY. Real values are supplied
# by the project owner from the live Supabase project dashboard and from
# the deployment platform's secret store. See docs/deployment.md.
#
# Architecture: Flutter -> FastAPI (this service) -> Supabase (Postgres + Auth)
# The Flutter client NEVER reads any value from this file.

# ---- runtime mode -----------------------------------------------------------
ENV=dev                              # dev | test | staging | prod
DATA_MODE=demo                       # demo | live   (live required in prod)
LOG_LEVEL=INFO
DEBUG=false

# ---- live Supabase project (https://rzmrjnegxgvnfgeuxaum.supabase.co) ------
# All four values are SERVER-SIDE ONLY. Never expose to the Flutter client.
SUPABASE_URL=https://rzmrjnegxgvnfgeuxaum.supabase.co
SUPABASE_ANON_KEY=replace-with-projects-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-projects-service-role-key
SUPABASE_JWT_SECRET=replace-with-projects-jwt-secret
SUPABASE_JWKS_URL=                    # preferred in prod: asymmetric JWKS
SUPABASE_STORAGE_BUCKET=field-reports

# ---- Postgres DSNs (live cloud Supabase) ------------------------------------
# Use the connection-pooler DSN for serverless functions; direct DSN for long-
# running workers. Examples below assume the project ref rzmrjnegxgvnfgeuxaum
# (replace with the values printed by the Supabase dashboard).
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PROJECT_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SYSTEM_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PROJECT_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- HTTP surface -----------------------------------------------------------
API_PUBLIC_URL=http://localhost:8000
# Explicit CORS origins (NEVER '*' for authenticated APIs).
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080","http://127.0.0.1:8080"]

# ---- abuse controls ---------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
RATE_LIMIT_PER_MINUTE=600

# ---- body size limits (Phase 26 hardening) ----------------------------------
MAX_BODY_BYTES=1048576                # 1 MiB JSON/API cap
MAX_UPLOAD_BYTES=10485760             # 10 MiB field-photo cap

# ---- map tiles --------------------------------------------------------------
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_USER_AGENT=NER-SHIELD/0.1

# ---- external providers (ALL OFF by design) ---------------------------------
# Adapters exist and boot cleanly when these are unset / false. Do not enable
# without procurement + signed contract per master-prompt §45.
# Credential env names below are placeholders — supply real values only in the
# deployment secret store, never in this file.
IMD_ENABLED=false
IMD_BASE_URL=
IMD_API_KEY=
WEATHER_ENABLED=false
WEATHER_BASE_URL=
WEATHER_API_KEY=
SACHET_ENABLED=false
COPERNICUS_ENABLED=false
CWC_ENABLED=false
ROUTING_ENABLED=true
ROUTING_PROVIDER=internal             # internal | osrm