# NER-SHIELD Flutter client — environment template
# Copy to .env (gitignored) or pass via --dart-define. NEVER commit real values.
#
# ONLY public / client-safe values belong here. Private secrets (service-role
# key, DB URL, JWT secret, provider API keys) stay server-side in the backend.
# See docs/security-plan.md and docs/backend-contract.md.

# ---- backend API (FastAPI) ---------------------------------------------------
API_BASE_URL=http://10.0.2.2:8000      # Android emulator -> host loopback
API_PUBLIC_URL=http://localhost:8000
# -----------------------------------------------------------------------------

# ---- Supabase (only PUBLIC anon key may ever ship in the client) -------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key      # public by design; keep optional

# ---- map tiles (OSM public; attribution required) ---------------------------
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---- runtime switches ---------------------------------------------------------
ENV=dev               # dev | staging | prod
DATA_MODE=demo        # demo shows SIMULATED/DEMO labels from backend; live = real
USE_SECURE_STORAGE=true
# -----------------------------------------------------------------------------

# ---- optional push -----------------------------------------------------------
# FCM config belongs in google-services.json; do not put keys here.